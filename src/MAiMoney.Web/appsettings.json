      { "Name": "Utilities", "Type": "Expense", "Color": "#6d4c41", "Description": "Electricity, water, internet, phone" },
      { "Name": "Entertainment", "Type": "Expense", "Color": "#d81b60", "Description": "Movies, games, subscriptions" },
      { "Name": "Health", "Type": "Expense", "Color": "#43a047", "Description": "Doctor, pharmacy, sport" },
      { "Name": "Shopping", "Type": "Expense", "Color": "#8e24aa", "Description": "Clothes, home, electronics" }
