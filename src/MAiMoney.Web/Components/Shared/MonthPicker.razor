<div class="month-picker" role="group" aria-label="Month">
    <button type="button" class="btn-icon" @onclick="() => ChangeAsync(-1)" aria-label="Previous month" title="Previous month">
        <Icon Name="chevron-left" />
    </button>
    <span class="month-picker-label">
        <Icon Name="calendar" Size="16" CssClass="text-body-secondary" />
        @Value.ToString("MMMM yyyy", CultureInfo.InvariantCulture)
    </span>
    <button type="button" class="btn-icon" @onclick="() => ChangeAsync(1)" aria-label="Next month" title="Next month">
        <Icon Name="chevron-right" />
    </button>
    @if (Value != ThisMonth)
    {
        <button type="button" class="month-picker-today" @onclick="() => ValueChanged.InvokeAsync(ThisMonth)">Today</button>
    }
</div>

@code {
    /// <summary>The first day of the selected month.</summary>
    [Parameter]
    public DateOnly Value { get; set; }

    [Parameter]
    public EventCallback<DateOnly> ValueChanged { get; set; }

    public static DateOnly ThisMonth
    {
        get
        {
            var today = DateTime.Today;
            return new DateOnly(today.Year, today.Month, 1);
        }
    }

    private Task ChangeAsync(int months) => ValueChanged.InvokeAsync(Value.AddMonths(months));
}
