<div class="month-picker" role="group" aria-label="Month">
    <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangeAsync(-1)" aria-label="Previous month">‹</button>
    <span class="month-picker-label">@Value.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>
    <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangeAsync(1)" aria-label="Next month">›</button>
</div>

@code {
    /// <summary>The first day of the selected month.</summary>
    [Parameter]
    public DateOnly Value { get; set; }

    [Parameter]
    public EventCallback<DateOnly> ValueChanged { get; set; }

    public static DateOnly ThisMonth
    {
        get
        {
            var today = DateTime.Today;
            return new DateOnly(today.Year, today.Month, 1);
        }
    }

    private Task ChangeAsync(int months) => ValueChanged.InvokeAsync(Value.AddMonths(months));
}
