<div class="type-toggle" role="group" aria-label="Type">
    <button type="button" class="type-toggle-btn type-toggle-expense @(Value == TransactionType.Expense ? "active" : null)"
            aria-pressed="@(Value == TransactionType.Expense)" @onclick="() => SelectAsync(TransactionType.Expense)">
        <Icon Name="arrow-up-right" Size="16" />Expense
    </button>
    <button type="button" class="type-toggle-btn type-toggle-income @(Value == TransactionType.Income ? "active" : null)"
            aria-pressed="@(Value == TransactionType.Income)" @onclick="() => SelectAsync(TransactionType.Income)">
        <Icon Name="arrow-down-left" Size="16" />Income
    </button>
</div>

@code {
    [Parameter]
    public TransactionType Value { get; set; }

    [Parameter]
    public EventCallback<TransactionType> ValueChanged { get; set; }

    private Task SelectAsync(TransactionType type) =>
        type == Value ? Task.CompletedTask : ValueChanged.InvokeAsync(type);
}
