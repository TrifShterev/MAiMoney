@* Modal for adding or editing a transaction. Render it with @if; it closes through OnSaved or OnCancel. *@
@inject ITransactionService Transactions
@inject CurrentUser CurrentUser
@inject MoneyFormatter Money

<Modal Title="@Title">
    <EditForm Model="input" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="modal-header">
            <h2 class="modal-title h5">@Title</h2>
            <button type="button" class="btn-close" aria-label="Close" @onclick="OnCancel"></button>
        </div>

        <div class="modal-body">
            @if (error is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@error</div>
            }

            <TypeToggle Value="input.Type" ValueChanged="SetType" />

            <div class="row g-3 mt-1">
                <div class="col-sm-6">
                    <label for="tx-amount" class="form-label">Amount (@Money.Currency)</label>
                    <InputNumber id="tx-amount" class="form-control" @bind-Value="input.Amount"
                                 step="0.01" min="0.01" placeholder="0.00" autofocus />
                    <ValidationMessage For="() => input.Amount" />
                </div>
                <div class="col-sm-6">
                    <label for="tx-date" class="form-label">Date</label>
                    <InputDate id="tx-date" class="form-control" @bind-Value="input.Date" />
                </div>
                <div class="col-12">
                    <label for="tx-category" class="form-label">Category</label>
                    <CategoryPicker Id="tx-category" Type="input.Type" @bind-Value="input.CategoryId" />
                    <ValidationMessage For="() => input.CategoryId" />
                </div>
                <div class="col-12">
                    <label for="tx-description" class="form-label">
                        Description <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <InputText id="tx-description" class="form-control" @bind-Value="input.Description"
                               maxlength="200" placeholder="e.g. Weekly groceries" />
                    <ValidationMessage For="() => input.Description" />
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-link text-secondary" @onclick="OnCancel">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Saving…" : "Save")</button>
        </div>
    </EditForm>
</Modal>

@code {
    /// <summary>The transaction to edit; null to add a new one.</summary>
    [Parameter]
    public TransactionDto? Transaction { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private TransactionInput input = new();
    private bool saving;
    private string? error;

    private string Title => Transaction is null ? "Add transaction" : "Edit transaction";

    protected override void OnInitialized()
    {
        if (Transaction is { } t)
        {
            input = new TransactionInput
            {
                Type = t.Type,
                Amount = t.Amount,
                Date = t.Date,
                CategoryId = t.CategoryId,
                Description = t.Description
            };
        }
    }

    private void SetType(TransactionType type)
    {
        input.Type = type;
        // Categories are per type, so the old choice no longer applies.
        input.CategoryId = null;
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            var userId = await CurrentUser.GetIdAsync();
            if (Transaction is null)
            {
                await Transactions.CreateAsync(userId, input);
            }
            else
            {
                await Transactions.UpdateAsync(userId, Transaction.Id, input);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) when (ex is ServiceValidationException or NotFoundException)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
