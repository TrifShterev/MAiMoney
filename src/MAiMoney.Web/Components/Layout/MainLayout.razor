@inherits LayoutComponentBase

<header class="app-header">
    <nav class="container app-nav">
        <a class="app-brand" href="">MAi<span>Money</span></a>

        <AuthorizeView>
            <Authorized>
                <div class="app-links">
                    <NavLink class="app-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink class="app-link" href="transactions">Transactions</NavLink>
                    <NavLink class="app-link" href="categories">Categories</NavLink>
                </div>
                <div class="app-user">
                    <span class="app-user-name">@context.User.Identity?.Name</span>
                    <form method="post" action="auth/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</header>

<main class="container app-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
