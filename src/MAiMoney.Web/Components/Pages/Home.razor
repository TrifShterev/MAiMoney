@page "/"
@attribute [Authorize]
@implements IDisposable
@inject ITransactionService Transactions
@inject CurrentUser CurrentUser
@inject MoneyFormatter Money
@inject DataChangeNotifier Notifier

<PageTitle>Dashboard · MAiMoney</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Your money at a glance</p>
    </div>
    <div class="page-actions">
        <MonthPicker Value="month" ValueChanged="ChangeMonthAsync" />
        <button type="button" class="btn btn-primary" @onclick="() => showEditor = true">
            <Icon Name="plus" />Add transaction
        </button>
    </div>
</div>

@if (summary is null)
{
    <div class="row g-3 mb-4">
        @for (var i = 0; i < 3; i++)
        {
            <div class="col-md-4"><div class="stat-card skeleton" style="height: 8.5rem"></div></div>
        }
    </div>
    <div class="panel skeleton" style="height: 18rem"></div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon stat-icon-income"><Icon Name="trending-up" /></span>
                    <span class="stat-label">Income</span>
                </div>
                <div class="stat-value">@Money.Format(summary.TotalIncome)</div>
                <div class="stat-foot">
                    @(incomeCategories.Count switch
                    {
                        0 => "Nothing received yet",
                        1 => "From 1 source",
                        var n => $"From {n} sources"
                    })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-head">
                    <span class="stat-icon stat-icon-expense"><Icon Name="trending-down" /></span>
                    <span class="stat-label">Expenses</span>
                </div>
                <div class="stat-value">@Money.Format(summary.TotalExpenses)</div>
                <div class="stat-foot">
                    @if (BudgetCount == 0)
                    {
                        <span>No budgets set</span>
                    }
                    else if (OverBudgetCount == 0)
                    {
                        <span class="text-income">All @BudgetCount budgets on track</span>
                    }
                    else
                    {
                        <span class="text-expense">@OverBudgetCount of @BudgetCount budgets exceeded</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-balance">
                <div class="stat-head">
                    <span class="stat-icon stat-icon-brand"><Icon Name="scale" /></span>
                    <span class="stat-label">Balance</span>
                </div>
                <div class="stat-value @(summary.Balance < 0 ? "text-expense" : null)">@Money.Format(summary.Balance)</div>
                <div class="stat-foot">
                    @if (summary.TotalIncome > 0 && summary.Balance >= 0)
                    {
                        <span>You kept <strong>@Pct(summary.Balance / summary.TotalIncome * 100)%</strong> of your income</span>
                    }
                    else if (summary.Balance < 0)
                    {
                        <span class="text-expense">You spent more than you earned</span>
                    }
                    else
                    {
                        <span>Income minus expenses</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (HasActivity)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <section class="panel h-100">
                    <div class="panel-header">
                        <h2 class="panel-title">Income vs expenses</h2>
                    </div>
                    <BalanceDonut Summary="summary" />
                </section>
            </div>
            <div class="col-lg-7">
                <section class="panel h-100">
                    <DailyTrendChart Days="days" />
                </section>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="panel">
                <div class="panel-header">
                    <h2 class="panel-title">Spending by category</h2>
                    @if (summary.TotalExpenses > 0)
                    {
                        <span class="panel-meta">@Money.Format(summary.TotalExpenses)</span>
                    }
                </div>

                @if (summary.TotalExpenses > 0)
                {
                    <div class="share-bar" role="img" aria-label="Share of spending per category">
                        @foreach (var category in expenseCategories.Where(c => c.Total > 0))
                        {
                            <span style="width: @Pct(category.Total / summary.TotalExpenses * 100)%; background-color: @(category.Color ?? "#adb5bd")"
                                  title="@category.Name · @Pct(category.Total / summary.TotalExpenses * 100)%"></span>
                        }
                    </div>
                }

                @if (expenseCategories.Count == 0)
                {
                    <div class="empty-state empty-state-sm">
                        <span class="empty-state-icon"><Icon Name="pie" Size="22" /></span>
                        <p class="mb-0">No expenses in @MonthName yet.</p>
                    </div>
                }
                @foreach (var category in expenseCategories)
                {
                    <div class="budget-row">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <CategoryLabel Name="@category.Name" Color="@category.Color" />
                            <span class="fw-semibold text-nowrap">
                                @Money.Format(category.Total)
                                @if (category.MonthlyBudget is { } budget)
                                {
                                    <span class="text-body-secondary fw-normal"> / @Money.Format(budget)</span>
                                }
                            </span>
                        </div>
                        @if (category.MonthlyBudget is { } limit)
                        {
                            var percent = category.BudgetUsedPercent ?? (category.Total > 0 ? 100 : 0);
                            <div class="progress mt-2" role="progressbar" aria-label="@category.Name budget used"
                                 aria-valuenow="@Pct(percent)" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @BarClass(category, percent)" style="width: @Pct(Math.Min(percent, 100))%"></div>
                            </div>
                            <div class="budget-note @(category.IsOverBudget ? "text-expense" : null)">
                                @(category.IsOverBudget
                                    ? $"Over budget by {Money.Format(category.Total - limit)}"
                                    : $"{Money.Format(limit - category.Total)} left · {Pct(percent)}% used")
                            </div>
                        }
                        else if (summary.TotalExpenses > 0)
                        {
                            <div class="budget-note">@Pct(category.Total / summary.TotalExpenses * 100)% of spending · no budget</div>
                        }
                    </div>
                }
            </section>

            @if (incomeCategories.Count > 0)
            {
                <section class="panel mt-4">
                    <div class="panel-header">
                        <h2 class="panel-title">Income by category</h2>
                        <span class="panel-meta">@Money.Format(summary.TotalIncome)</span>
                    </div>
                    @foreach (var category in incomeCategories)
                    {
                        <div class="d-flex justify-content-between gap-2 py-1">
                            <CategoryLabel Name="@category.Name" Color="@category.Color" />
                            <span class="fw-semibold text-income text-nowrap">@Money.Format(category.Total)</span>
                        </div>
                    }
                </section>
            }
        </div>

        <div class="col-lg-5">
            <section class="panel">
                <div class="panel-header">
                    <h2 class="panel-title">Recent transactions</h2>
                    <a href="transactions" class="panel-link">See all <Icon Name="chevron-right" Size="14" /></a>
                </div>
                @if (recent.Count == 0)
                {
                    <div class="empty-state empty-state-sm">
                        <span class="empty-state-icon"><Icon Name="inbox" Size="22" /></span>
                        <p class="mb-3">Nothing recorded in @MonthName yet.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => showEditor = true">Add a transaction</button>
                    </div>
                }
                <ul class="tx-list">
                    @foreach (var t in recent)
                    {
                        <li class="tx-item">
                            <CategoryAvatar Name="@t.CategoryName" Color="@t.CategoryColor" />
                            <div class="tx-main">
                                <div class="tx-title">@(t.Description ?? t.CategoryName)</div>
                                <div class="tx-sub">
                                    @t.Date.ToString("dd MMM", CultureInfo.InvariantCulture)@(t.Description is null ? "" : $" · {t.CategoryName}")
                                </div>
                            </div>
                            <span class="tx-amount @AmountClass(t.Type)">@Money.FormatSigned(t.Amount, t.Type)</span>
                        </li>
                    }
                </ul>
            </section>
        </div>
    </div>
}

@if (showEditor)
{
    <TransactionEditor OnSaved="() => showEditor = false" OnCancel="() => showEditor = false" />
}

@code {
    private DateOnly month = MonthPicker.ThisMonth;
    private MonthlySummary? summary;
    private List<CategorySummary> expenseCategories = [];
    private List<CategorySummary> incomeCategories = [];
    private IReadOnlyList<TransactionDto> recent = [];
    private IReadOnlyList<DailyTotal> days = [];
    private bool showEditor;

    private string MonthName => month.ToString("MMMM", CultureInfo.InvariantCulture);

    // The charts only show for a month with transactions.
    private bool HasActivity => summary is not null && summary.TotalIncome + summary.TotalExpenses > 0;

    private int BudgetCount => expenseCategories.Count(c => c.MonthlyBudget is not null);

    private int OverBudgetCount => expenseCategories.Count(c => c.IsOverBudget);

    protected override Task OnInitializedAsync()
    {
        Notifier.Changed += OnDataChanged;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var userId = await CurrentUser.GetIdAsync();
        summary = await Transactions.GetMonthlySummaryAsync(userId, month.Year, month.Month);
        expenseCategories = summary.Categories.Where(c => c.Type == TransactionType.Expense).ToList();
        incomeCategories = summary.Categories.Where(c => c.Type == TransactionType.Income && c.Total > 0).ToList();
        recent = await Transactions.GetAsync(userId, new TransactionFilter { Year = month.Year, Month = month.Month, Limit = 6 });
        days = HasActivity ? await Transactions.GetDailyTotalsAsync(userId, month.Year, month.Month) : [];
    }

    private Task ChangeMonthAsync(DateOnly value)
    {
        month = value;
        return LoadAsync();
    }

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private static string Pct(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string BarClass(CategorySummary category, decimal percent) =>
        category.IsOverBudget ? "bg-danger" : percent >= 80 ? "bg-warning" : "bg-success";

    private static string AmountClass(TransactionType type) =>
        type == TransactionType.Income ? "text-income" : "text-expense";

    public void Dispose() => Notifier.Changed -= OnDataChanged;
}
