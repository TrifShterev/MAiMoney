@page "/categories"
@attribute [Authorize]
@implements IDisposable
@inject ICategoryService Categories
@inject CurrentUser CurrentUser
@inject MoneyFormatter Money
@inject DataChangeNotifier Notifier
@inject ToastService Toasts

<PageTitle>Categories · MAiMoney</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Group your transactions and set monthly budgets</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" @onclick="() => OpenCreate(TransactionType.Expense)">
            <Icon Name="plus" />New category
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger py-2" role="alert">@error</div>
}

@if (categories is null)
{
    <div class="row g-4">
        <div class="col-lg-6"><div class="panel skeleton" style="height: 20rem"></div></div>
        <div class="col-lg-6"><div class="panel skeleton" style="height: 12rem"></div></div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var type in new[] { TransactionType.Expense, TransactionType.Income })
        {
            var items = categories.Where(c => c.Type == type).ToList();
            var isExpense = type == TransactionType.Expense;
            <div class="col-lg-6">
                <section class="panel">
                    <div class="panel-header">
                        <h2 class="panel-title">
                            <span class="stat-icon stat-icon-sm @(isExpense ? "stat-icon-expense" : "stat-icon-income")">
                                <Icon Name="@(isExpense ? "arrow-up-right" : "arrow-down-left")" Size="15" />
                            </span>
                            @(isExpense ? "Expenses" : "Income")
                            <span class="count-badge">@items.Count</span>
                        </h2>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenCreate(type)">
                            <Icon Name="plus" Size="15" />Add
                        </button>
                    </div>

                    @if (items.Count == 0)
                    {
                        <div class="empty-state empty-state-sm">
                            <span class="empty-state-icon"><Icon Name="tag" Size="22" /></span>
                            <p class="mb-0">No @(isExpense ? "expense" : "income") categories yet.</p>
                        </div>
                    }
                    <ul class="list-unstyled mb-0">
                        @foreach (var category in items)
                        {
                            <li class="category-item" @key="category.Id">
                                <CategoryAvatar Name="@category.Name" Color="@category.Color" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold">@category.Name</div>
                                    @if (category.Description is not null)
                                    {
                                        <div class="small text-body-secondary">@category.Description</div>
                                    }
                                    @if (category.MonthlyBudget is { } budget)
                                    {
                                        <span class="chip chip-sm mt-1">Budget @Money.Format(budget) / month</span>
                                    }
                                </div>
                                <div class="category-actions">
                                    @if (confirmDeleteId == category.Id)
                                    {
                                        <span class="small me-1">Delete?</span>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(category)">Yes</button>
                                        <button type="button" class="btn btn-sm btn-link text-body-secondary" @onclick="() => confirmDeleteId = null">No</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-icon" title="Edit" aria-label="Edit @category.Name" @onclick="() => OpenEdit(category)">
                                            <Icon Name="pencil" Size="16" />
                                        </button>
                                        <button type="button" class="btn-icon btn-icon-danger" title="Delete" aria-label="Delete @category.Name" @onclick="() => AskDelete(category.Id)">
                                            <Icon Name="trash" Size="16" />
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        }
    </div>
}

@if (showEditor)
{
    <CategoryEditor Category="editing" DefaultType="newType" OnSaved="CloseEditor" OnCancel="CloseEditor" />
}

@code {
    private IReadOnlyList<CategoryDto>? categories;
    private string? confirmDeleteId;
    private string? error;
    private bool showEditor;
    private CategoryDto? editing;
    private TransactionType newType = TransactionType.Expense;

    protected override Task OnInitializedAsync()
    {
        Notifier.Changed += OnDataChanged;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        confirmDeleteId = null;
        categories = await Categories.GetAllAsync(await CurrentUser.GetIdAsync());
    }

    private void OpenCreate(TransactionType type)
    {
        editing = null;
        newType = type;
        error = null;
        showEditor = true;
    }

    private void OpenEdit(CategoryDto category)
    {
        editing = category;
        error = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editing = null;
    }

    // Saved here, from the header's quick add, or from a transaction form.
    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void AskDelete(string id)
    {
        error = null;
        confirmDeleteId = id;
    }

    private async Task DeleteAsync(CategoryDto category)
    {
        try
        {
            await Categories.DeleteAsync(await CurrentUser.GetIdAsync(), category.Id);
            Toasts.Show($"Category “{category.Name}” deleted");
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ServiceValidationException or NotFoundException)
        {
            confirmDeleteId = null;
            error = ex.Message;
        }
    }

    public void Dispose() => Notifier.Changed -= OnDataChanged;
}
