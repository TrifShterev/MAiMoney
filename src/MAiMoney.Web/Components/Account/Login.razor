@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Log in · MAiMoney</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <span class="auth-mark"><Icon Name="wallet" Size="22" /></span>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Log in to keep track of your money.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger py-2" role="alert">@Error</div>
        }

        <form method="post" action="auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="email" class="form-control" autocomplete="username" required autofocus />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="form-check mb-3">
                <input id="rememberMe" name="rememberMe" type="checkbox" class="form-check-input" value="true" />
                <label for="rememberMe" class="form-check-label">Keep me logged in</label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>

        <p class="auth-switch">New here? <a href="account/register">Create an account</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
