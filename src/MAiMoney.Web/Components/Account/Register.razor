@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Create account · MAiMoney</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="h4 mb-1">Create your account</h1>
        <p class="text-muted">We'll set you up with a few common categories to start with.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger py-2" role="alert">@Error</div>
        }

        <form method="post" action="auth/register">
            <AntiforgeryToken />
            <div class="mb-3">
                <label for="displayName" class="form-label">Your name</label>
                <input id="displayName" name="displayName" class="form-control" autocomplete="name" maxlength="50" required autofocus />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="email" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control" autocomplete="new-password"
                       minlength="@UserService.MinPasswordLength" required />
                <div class="form-text">At least @UserService.MinPasswordLength characters.</div>
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password"
                       minlength="@UserService.MinPasswordLength" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <p class="mt-3 mb-0 text-center small">Already have an account? <a href="account/login">Log in</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
